@using Nop.Core.Domain.Topics
@using Nop.Services.Seo
@using Nop.Services.Topics

@inject ITopicService topicService
@inject IUrlRecordService urlRecordService

@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts("Контакты");
    //page class
    NopHtml.AppendPageCssClassParts("html-contact-page");

    var contactTopic = await topicService.GetTopicBySystemNameAsync("ContactUs")
        ?? await topicService.GetTopicBySystemNameAsync("Контакты");

    if (contactTopic == null)
    {
        var contactUrlRecord = await urlRecordService.GetBySlugAsync("contact-us")
            ?? await urlRecordService.GetBySlugAsync("contacts")
            ?? await urlRecordService.GetBySlugAsync("контакты");

        if (contactUrlRecord != null && contactUrlRecord.EntityName == nameof(Topic))
            contactTopic = await topicService.GetTopicByIdAsync(contactUrlRecord.EntityId);
    }

    if (contactTopic != null && (!contactTopic.Published || !topicService.TopicIsAvailable(contactTopic)))
        contactTopic = null;
}

<div class="page-layout contactus-page">
    <div class="wrapper">
        <main class="contactus-page__main">
            <h1 class="page-title contactus-page__title">Контакты</h1>

            @if (contactTopic != null && !string.IsNullOrWhiteSpace(contactTopic.Body))
            {
                <div class="contactus-page__content">
                    @Html.Raw(contactTopic.Body)
                </div>
            }
        </main>
    </div>
</div>

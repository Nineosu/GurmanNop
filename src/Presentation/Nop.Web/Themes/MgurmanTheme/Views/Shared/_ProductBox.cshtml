@model ProductOverviewModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Http

@inject CatalogSettings catalogSettings
@inject IWorkContext workContext
@inject INopUrlHelper NopUrl

@{
    var addtowishlistlink = Url.RouteUrl(
        NopRouteNames.Ajax.ADD_PRODUCT_TO_WISHLIST_CATALOG,
        new
        {
            productId = Model.Id
        });

    var addtocomparelink = Url.RouteUrl(
        NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE,
        new
        {
            productId = Model.Id
        });
}

<article class="product__card" data-productid="@Model.Id">

    <div class="product__card-img-block">

        <button class="product__card-favorite-btn"
                type="button"
                title="@T("ShoppingCart.AddToWishlist")"
                data-productid="@Model.Id"
                onclick="toggleWishlist(this, '@addtowishlistlink');return false;">
            <svg class="favorite-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
        </button>

        @{
            var picture = Model.PictureModels.FirstOrDefault();
        }

        <a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))" title="@picture?.Title">
            <img src="@picture?.ImageUrl" alt="@picture?.AlternateText" title="@picture?.Title" class="product__card-img" />
        </a>
    </div>

    <div class="product__card-info">
        <div class="product__card-price-block">
            <p class="product__card-price">
                @Html.Raw(Model.ProductPrice.Price)
            </p>
        </div>

        <a class="product__card-title"
           href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))">
            @Model.Name
        </a>
    </div>

    <div class="product__card-bottom">
        @{
            var isWeightProduct = Model.MeasureTypeId == 1;
        }

        <div class="product-card__counter product-counter"
             data-unit="@(isWeightProduct ? "kg" : "piece")"
             data-step="@(isWeightProduct ? "0.1" : "1")"
             data-min="@(isWeightProduct ? "0.1" : "1")"
             data-max="@(isWeightProduct ? "2" : "99")">

            <button type="button" class="counter-btn counter-block btn-minus"></button>

            <div class="counter-block counter__value-block">
                <div class="counter-value-group">
                    <input type="text"
                           class="counter-value"
                           value="@(isWeightProduct ? "1.0" : "1")"
                           inputmode="decimal"
                    @(isWeightProduct ? "readonly" : "")>

                    <span class="counter-unit">
                        @(isWeightProduct ? "кг" : "шт")
                    </span>
                </div>
            </div>

            <button type="button" class="counter-btn counter-block btn-plus"></button>

        </div>

        @if (!Model.ProductPrice.DisableBuyButton)
        {
            if (isWeightProduct)
            {
                <button type="button"
                        class="product__card-buy"
                        onclick="location.href='@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))'">

                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/product-buy-ico.svg")"
                         class="product__card-buy-img">
                </button>
            }
            else
            {
                <button type="button"
                        class="product__card-buy"
                        data-productid="@Model.Id">

                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/product-buy-ico.svg")"
                         class="product__card-buy-img">
                </button>
            }
        }
    </div>

</article>
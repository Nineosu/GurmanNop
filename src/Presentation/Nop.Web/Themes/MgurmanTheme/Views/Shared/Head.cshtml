@using Nop.Core.Domain.Catalog
@using Nop.Services.Helpers

@inject CatalogSettings catalogSettings
@inject IThemeContext themeContext
@inject IUserAgentHelper userAgentHelper

@{
    Layout ="";
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var supportRtl = await Html.ShouldUseRtlThemeAsync();

    //Main css file
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/styles{(supportRtl ? ".rtl" : "")}.css");
    
    //Swiper css file
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/lib/swiper/swiper-bundle.min.css");

    //Flatpickr css file
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/lib/flatpickr/flatpickr.min.css");

    // add jQuery UI css file
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");


    //Swiper JS
    NopHtml.AppendScriptParts(ResourceLocation.Footer,
        $"~/Themes/{themeName}/Content/lib/swiper/swiper-bundle.min.js");

    //Flatpickr JS
    NopHtml.AppendScriptParts(ResourceLocation.Footer,
    $"~/Themes/{themeName}/Content/lib/flatpickr/flatpickr.ru.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer,
        $"~/Themes/{themeName}/Content/lib/flatpickr/flatpickr.min.js");

    NopHtml.AppendScriptParts(ResourceLocation.Footer,
    "~/lib_npm/jquery/jquery.min.js");

    //Main JS
    // NopHtml.AppendScriptParts(ResourceLocation.Footer,
    //     $"~/Themes/{themeName}/Content/js/script.js");
}
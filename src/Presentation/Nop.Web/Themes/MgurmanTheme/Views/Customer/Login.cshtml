@model LoginModel
@using Nop.Core
@using Nop.Core.Domain.Customers
@using Nop.Core.Http
@inject IWebHelper webHelper

@inject IWebHelper webHelper
@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("PageTitle.Login").Text);
    NopHtml.AppendPageCssClassParts("html-login-page");

    var registerUrl = Url.RouteUrl(NopRouteNames.Standard.REGISTER, new { returnUrl = Context.Request.Query["returnUrl"] }, webHelper.GetCurrentRequestProtocol());
}

<div class="page-layout simple-layout">

    <div class="account-page__background">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" class="background-img">
    </div>

    <div class="wrapper">

        <main class="main-login">

            <p class="login__title page-title">
                @T("Account.Login.Welcome")
            </p>

            @await Html.PartialAsync("_ExternalAuthentication.Errors")

            <div class="page-body">

                @await Component.InvokeAsync(typeof(WidgetViewComponent),
                    new { widgetZone = PublicWidgetZones.LoginTop, additionalData = Model })

                <form asp-route="@NopRouteNames.General.LOGIN"
                      asp-route-returnurl="@Context.Request.Query["ReturnUrl"]"
                      method="post"
                      autocomplete="off"
                      class="login-form"
                      id="login-form"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="form-error--form">
                        @T("Account.Login.Unsuccessful")
                    </div>

                    <div class="input-block">

                        @if (Model.UsernamesEnabled)
                        {
                            <div class="input-group input-group_column">
                                <div class="input-wrapper">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-2.svg")" class="profile-form__icon">

                                    <input asp-for="Username"
                                           class="profile-form__input"
                                           placeholder="Username"
                                           autofocus />
                                </div>

                                <span asp-validation-for="Username"></span>
                            </div>
                        }
                        else
                        {
                            <div class="input-group input-group_column">
                                <div class="input-wrapper">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-2.svg")" class="profile-form__icon">

                                    <input asp-for="Email"
                                           class="profile-form__input"
                                           placeholder="E-mail"
                                           autofocus />
                                </div>

                                <span asp-validation-for="Email"></span>
                            </div>
                        }

                        <div class="input-group input-group_column password-group">
                            <div class="input-wrapper">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account_password-ico.svg")"
                                     class="profile-form__icon">

                                <div class="password-wrapper">
                                    <input asp-for="Password"
                                           class="profile-form__input"
                                           placeholder="Пароль" />

                                    <button type="button" class="password-toggle">
                                        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-show.svg")"
                                             class="password-ico password-ico_show">
                                        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-hide.svg")"
                                             class="password-ico password-ico_hide hidden">
                                    </button>
                                </div>
                            </div>

                            <span asp-validation-for="Password"></span>
                        </div>

                    </div>

                    <div class="login__bottom-fields">

                        <div class="input-group">
                            <label class="checkbox interactive">
                                <input asp-for="RememberMe">
                                <span class="checkmark"></span>
                                <span class="text">Запомнить меня</span>
                            </label>
                        </div>

                        <div class="input-group">
                            <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY"
                                   class="forgot-password__btn">
                                @T("Account.Login.ForgotPassword")
                            </a>
                        </div>

                    </div>

                    <div class="login-form__btns">

                        <button type="submit" class="login-form__btn login-btn">
                            @T("Account.Login.LoginButton")
                        </button>

                        <a href="@registerUrl" class="login-form__btn register-btn">
                            @T("Account.Register")
                        </a>

                    </div>

                    @if (Model.DisplayCaptcha)
                    {
                        <nop-captcha />
                    }

                </form>

                <div class="login__note-block">
                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/login-note.svg")"
                         class="login__note-img">

                    <p class="login__note-text">
                        @T("Account.Login.NewCustomerText")
                    </p>
                </div>

                <div class="external-authentication">
                    @await Component.InvokeAsync(typeof(ExternalMethodsViewComponent),
                        "ExternalAuthentication")
                </div>

            </div>
        </main>
    </div>
</div>
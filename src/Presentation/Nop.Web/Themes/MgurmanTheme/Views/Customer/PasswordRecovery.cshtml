@using Nop.Core.Http

@model PasswordRecoveryModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}

<div class="page-layout simple-layout">
    <div class="account-page__background">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
    </div>

    <div class="wrapper">
        <main class="main-reset">
            <p class="reset__title page-title">
                Восстановление пароля
            </p>

            <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY"
                  method="post"
                  class="reset-form reset-form--email">

                <div asp-validation-summary="ModelOnly"
                     class="message-error"></div>

                <p class="reset-form__title">
                    Введите e-mail, на который будет отправлена ссылка для сброса пароля.
                </p>

                <div class="input-group input-group_column">
                    <div class="input-wrapper">
                        <img src="~/Themes/MgurmanTheme/Content/images/account-ico-2.svg"
                             class="profile-form__icon"
                             alt=""
                             style="opacity: 0; pointer-events: none;">

                        <input asp-for="Email"
                               class="profile-form__input"
                               placeholder="E-mail"
                               autocomplete="email" />
                    </div>

                    <span asp-validation-for="Email"></span>

                </div>

                @if (Model.DisplayCaptcha)
                {
                    <nop-captcha />
                }

                <button type="submit"
                        name="send-email"
                        class="login-form__btn login-btn">
                    Продолжить
                </button>
            </form>
        </main>
    </div>
</div>
@using Nop.Core.Http

@model ChangePasswordModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);

    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-change-password-page");

    var returnUrl = Context.Request.Query["returnUrl"];
}

<div class="page-layout">

    <div class="account-page__background">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
    </div>

    <div class="wrapper">

        <div class="account-menu">

            <div class="account-menu__top">

                <p class="account-menu__title">
                    Личный кабинет
                </p>

                <div class="account-menu__btns">
                    <a href="@Url.RouteUrl("CustomerInfo")"
                           class="account-menu__btn">
                        Профиль
                    </a>

                    <a href="@Url.RouteUrl("CustomerChangePassword")"
                           class="account-menu__btn btn-active">
                        Конфиденциальность
                    </a>

                    <a href="@Url.RouteUrl("CustomerOrders")"
                           class="account-menu__btn">
                        История заказов
                    </a>
                </div>

            </div>

            <div class="account-menu__bottom">

                <a href="/logout"
                       class="account-menu__exit-btn">
                    Выйти
                </a>

            </div>

        </div>

        <main class="main-account">

            <div class="account-tab security-tab">

                <p class="account-tab__title page-title">
                    Конфиденциальность
                </p>

                <div class="account-security__info">
                    Здесь можно изменить пароль для входа в личный кабинет.
                </div>

                @await Component.InvokeAsync(
                    typeof(WidgetViewComponent),
                    new
                    {
                        widgetZone = PublicWidgetZones.CustomerChangePasswordTop,
                        additionalData = Model
                    })

                <form asp-route="@NopRouteNames.Standard.CUSTOMER_CHANGE_PASSWORD"
                      method="post"
                      autocomplete="off"
                      asp-route-returnurl="@returnUrl"
                      class="account__profile-form"
                      id="account-security">

                    <div asp-validation-summary="ModelOnly"
                         class="message-error">
                    </div>

                    <div class="warnings">

                        @if (Model.PasswordExpired)
                        {
                            <p>@T("Account.ChangePassword.PasswordIsExpired")</p>
                        }

                        @if (Model.PasswordMustBeChanged)
                        {
                            <p>@T("Account.ChangePassword.MustBeChanged")</p>
                        }

                    </div>

                    <div class="input-group input-group_column">

                        <div class="input-wrapper">
                            <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account_password-ico.svg")"
                                 alt=""
                                 class="profile-form__icon">

                            <div class="password-wrapper">
                                <input asp-for="OldPassword"
                                       class="profile-form__input"
                                       placeholder="Текущий пароль" />

                                <button type="button" class="password-toggle">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-show.svg")"
                                         class="password-ico password-ico_show">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-hide.svg")"
                                         class="password-ico password-ico_hide hidden">
                                </button>
                            </div>
                        </div>

                        <span asp-validation-for="OldPassword"></span>
                    </div>

                    <div class="input-group input-group_column">
                        <div class="input-wrapper">
                            <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account_password-ico.svg")"
                                 alt=""
                                 class="profile-form__icon"
                                 style="opacity: 0; pointer-events: none;">

                            <div class="password-wrapper">
                                <input asp-for="NewPassword"
                                       class="profile-form__input"
                                       placeholder="Новый пароль" />

                                <button type="button" class="password-toggle">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-show.svg")"
                                         class="password-ico password-ico_show">
                                    <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-hide.svg")"
                                         class="password-ico password-ico_hide hidden">
                                </button>
                            </div>
                        </div>

                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="input-group input-group_column">
                        <div class="input-wrapper">
                            <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account_password-ico.svg")"
                                 alt=""
                                 class="profile-form__icon" style="opacity: 0; pointer-events: none;">

                            <input asp-for="ConfirmNewPassword"
                                   class="profile-form__input"
                                   placeholder="Подтверждение пароля" />

                            <button type="button" class="password-toggle">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-show.svg")"
                                     class="password-ico password-ico_show">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/password-hide.svg")"
                                     class="password-ico password-ico_hide hidden">
                            </button>
                        </div>
                        
                        <span asp-validation-for="ConfirmNewPassword"></span>
                    </div>

                    <div class="change-password-form__bottom">
                        <a asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY"
                               class="change-password-recovery-link">
                            Сбросить пароль
                        </a>

                        <button type="submit"
                                class="profile-form__submit">
                            Сохранить
                        </button>
                    </div>
                </form>

                <a href="/logout"
                       class="account-menu__exit-btn mobile__exit-btn">
                    Выйти
                </a>

                @await Component.InvokeAsync(
                    typeof(WidgetViewComponent),
                    new
                    {
                        widgetZone = PublicWidgetZones.CustomerChangePasswordBottom,
                        additionalData = Model
                    })

            </div>

        </main>

    </div>

</div>
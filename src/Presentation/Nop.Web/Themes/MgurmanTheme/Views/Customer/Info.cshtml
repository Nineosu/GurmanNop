@model CustomerInfoModel

@using Nop.Web.Models.Customer
@using Nop.Web.Framework.UI
@using Nop.Web.Framework.Models.DataTables
@using Nop.Core.Domain.Cms

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);

    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-customer-info-page");
}

<div class="page-layout">

    <div class="account-page__background">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-2.svg")" alt="" class="background-img">
        <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-bg-1.svg")" alt="" class="background-img">
    </div>

    <div class="wrapper">

        <div class="account-menu">

            <div class="account-menu__top">

                <p class="account-menu__title">
                    Личный кабинет
                </p>

                <div class="account-menu__btns">
                    <a href="@Url.RouteUrl("CustomerInfo")"
                           class="account-menu__btn btn-active">
                        Профиль
                    </a>

                    <a href="@Url.RouteUrl("CustomerChangePassword")"
                           class="account-menu__btn">
                        Конфиденциальность
                    </a>

                    <a href="@Url.RouteUrl("CustomerOrders")"
                           class="account-menu__btn">
                        История заказов
                    </a>
                </div>

            </div>

            <div class="account-menu__bottom">

                <a href="/logout"
                       class="account-menu__exit-btn">
                    Выйти
                </a>

            </div>

        </div>

        <main class="main-account">

            <div class="account-tab profile-tab">

                <p class="account-tab__title page-title">
                    Профиль
                </p>

                @await Component.InvokeAsync(typeof(WidgetViewComponent),
                    new
                    {
                        widgetZone = PublicWidgetZones.CustomerInfoTop,
                        additionalData = Model
                    })

                <form asp-route="CustomerInfo"
                      method="post"
                      id="account-profile"
                      class="account__profile-form">

                    <div asp-validation-summary="ModelOnly"
                         class="message-error">
                    </div>

                    @if (Model.FirstNameEnabled)
                    {
                        <div class="input-group input-group_column">
                            <div class="input-wrapper">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-1.svg")"
                                     alt=""
                                     class="profile-form__icon">

                                <input asp-for="FirstName"
                                       class="profile-form__input"
                                       placeholder="Имя" />
                            </div>

                            <span asp-validation-for="FirstName"></span>
                        </div>
                    }

                    @if (Model.LastNameEnabled)
                    {
                        <div class="input-group input-group_column">
                            <div class="input-wrapper">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-1.svg")"
                                     alt=""
                                     class="profile-form__icon">

                                <input asp-for="LastName"
                                       class="profile-form__input"
                                       placeholder="Фамилия" />
                            </div>

                            <span asp-validation-for="LastName"></span>
                        </div>
                    }

                    <div class="input-group input-group_column">
                        <div class="input-wrapper">
                            <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-2.svg")"
                                 alt=""
                                 class="profile-form__icon">

                            <input asp-for="Email"
                                   class="profile-form__input"
                                   placeholder="E-mail" />
                        </div>

                        <span asp-validation-for="Email"></span>
                    </div>

                    @if (Model.PhoneEnabled)
                    {
                        <div class="input-group input-group_column">
                            <div class="input-wrapper">
                                <img src="~/Themes/MgurmanTheme/Content/images/account-ico-4.svg"
                                     class="profile-form__icon"
                                     alt="">

                                <input asp-for="Phone"
                                       class="profile-form__input"
                                       placeholder="Телефон" />
                            </div>

                            <span asp-validation-for="Phone"></span>
                        </div>
                    }

                    @if (Model.StreetAddressEnabled)
                    {
                        <div class="input-group input-group_column">
                            <div class="input-wrapper">
                                <img src="@Url.Content("~/Themes/MgurmanTheme/Content/images/account-ico-3.svg")"
                                     alt=""
                                     class="profile-form__icon">

                                <input asp-for="StreetAddress"
                                       class="profile-form__input"
                                       placeholder="Адрес" />
                            </div>

                            <span asp-validation-for="StreetAddress"></span>
                        </div>
                    }

                    <button type="submit"
                            id="save-info-button"
                            name="save-info-button"
                            class="profile-form__submit">
                        Сохранить
                    </button>

                </form>

                <a href="/logout"
                       class="account-menu__exit-btn mobile__exit-btn">
                    Выйти
                </a>

                @await Component.InvokeAsync(typeof(WidgetViewComponent),
                    new
                    {
                        widgetZone = PublicWidgetZones.CustomerInfoBottom,
                        additionalData = Model
                    })

            </div>

        </main>

    </div>

</div>
@model Custom.Weighable.Models.WeighableModel

<div class="form-group">
    <label>
        <input type="checkbox"
               id="IsWeighable"
               @(Model.IsWeighable ? "checked" : "") />
        Весовой товар
    </label>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkbox = document.getElementById("IsWeighable");

        checkbox.addEventListener("change", function () {
            fetch('/Admin/WeighableAdmin/Save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=@Model.ProductId&isWeighable=' + checkbox.checked
            });
        });
    });
</script>